#compdef ifp

_ifp() {
  local context state state_descr line
  typeset -A opt_args

  # -- の位置を探す
  local double_dash_pos
  for ((i=2; i<=$#words; i++)); do
    if [[ ${words[$i]} == "--" ]]; then
      double_dash_pos=$i
      break
    fi
  done

  if [[ -n $double_dash_pos ]] && (( CURRENT > double_dash_pos )); then
    # -- の後：通常のコマンド補完を行う
    shift $((double_dash_pos)) words
    (( CURRENT -= double_dash_pos ))
    _normal
  else
    # -- の前：ifp のオプション補完
    _arguments \
      '(-h --help)'{-h,--help}'[Show help message]' \
      '-o[Output field number]:field number:' \
      '-d[Display fields (e.g., 1,3)]:field list:' \
      '-D[Field delimiter]:delimiter:' \
      '--no-clipboard[Do not copy to clipboard]' \
      '--[End of options, start command]'
  fi
}

_ifp "$@"
