#compdef mermaid

_mermaid() {
  _arguments \
    '-i[Input file]:input file:_files' \
    '-o[Output file]:output file:_files' \
    '--scale[Scale factor (default: 3)]:scale:' \
    '--assets-dir[Assets directory containing custom.css and config.json]:assets dir:_directories' \
    '(-h --help)'{-h,--help}'[Show help message]' \
    '*:other options:'
}

_mermaid "$@"
