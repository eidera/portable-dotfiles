#!/bin/bash

####
# インタラクティブシェルではない環境(Ex. Alfred, KeyboardMaestro, ...)でnodejs on miseのグローバルインストールされた環境を実行するツール
# miseが見つからない環境では、PATH上の素のnodejsを利用する
#
# Preparation
#   cp ~/bin/anode /usr/local/bin/.
# 
# Execution
#   anode npm ls -g # <- `npm ls -g`
#   anode node example.js
#   anode tsx example.ts

if [ -z "$1" ] ; then
  echo 1>&2 "Usage: $0 {node related command} {argument...}"
  exit 1
fi

MISE_SEARCH_PATHS=("$HOME/.local/bin/mise" "/opt/homebrew/bin/mise")

MISE=""
for p in "${MISE_SEARCH_PATHS[@]}"; do
  [ -x "$p" ] && MISE="$p" && break
done

if [ -n "$MISE" ]; then
  RUNNER=("$MISE" exec --)
elif command -v node >/dev/null 2>&1; then
  # mise がない環境では、PATH 上の素の node を使う
  RUNNER=()
else
  echo 1>&2 "mise も node も見つかりません"
  exit 1
fi

# npm がない環境もあるため、取得できたときだけ設定する
if NPM_ROOT=$("${RUNNER[@]}" npm root -g 2>/dev/null); then
  export NODE_PATH="$NPM_ROOT"
fi

exec "${RUNNER[@]}" "$@"
